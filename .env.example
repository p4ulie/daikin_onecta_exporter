# Copy to .env (git-ignored). Values come from the Daikin developer portal; see README.
DAIKIN_CLIENT_ID=
DAIKIN_CLIENT_SECRET=
# Defaults shown; DAIKIN_INTERVAL is seconds (minimum 60).
# DAIKIN_TOKEN_FILE=/data/token.json
# DAIKIN_TOKEN_JSON={"refresh_token": "...", "authorized_at": 0}
# DAIKIN_INTERVAL=600
# DAIKIN_EXPORTER_PORT=9879
# DAIKIN_REDIRECT_URI=https://localhost/
